NEWS_SOURCE_DOMAINS=
ARTICLE_PIPELINE_DEFAULT_TOPIC=latest tech news on MCP, agentic workflows, and SaaS AI infrastructure
MAX_ARTICLE_AGE_DAYS=14
ALLOW_UNDATED_ARTICLES=true
RSS_MAX_ITEMS_PER_FEED=25
SCOUT_MAX_TOTAL_ARTICLES=80
SCOUT_MAX_WORKERS=6
# Paywall/subscription exclusion (hybrid — three layers, all optional):
# 1. PAYWALLED_DOMAINS: hard-paywall, non-technical domains dropped at RSS level.
#    Keep small — never include mixed platforms like medium.com or substack.com.
PAYWALLED_DOMAINS=theinformation.com,thelogic.co
# 2. PAYWALL_MARKERS: substrings scanned in title+summary at RSS level (no fetch).
#    Catches paid Substack/Medium posts and paywall teasers. Comma-separated.
PAYWALL_MARKERS=this post is for paid subscribers,for paid subscribers,subscriber-only,subscribers only,members only,member-only story,subscribe to continue reading,subscribe to read,create an account to continue reading,you have reached your article limit,to continue reading, subscribe,premium content,sign in to read,register to read
# 3. PAYWALL_PROBE: opt-in fetch probe — fetches each surviving article body
#    (up to PAYWALL_PROBE_MAX) and drops pages behind a paywall/login wall.
#    Most accurate but adds HTTP fetches to the synchronous scout. Default off.
PAYWALL_PROBE=false
PAYWALL_PROBE_MAX=40
# Few-shot examples of your actual writing, injected into the author prompt to
# match your voice. Set to inline text (separate examples with a line of ---)
# or a file path prefixed with "file:". Leave empty to disable.
WRITER_EXAMPLES=
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
CHECKPOINT_DB_PATH=checkpoints.db
DOMAIN_STORE_DB_PATH=domains.db
COST_TRACKER_DB_PATH=costs.db
STYLE_PROFILE_DB_PATH=style_profile.db
ENABLE_FACTUALITY_CHECK=true
SSE_STREAM_TIMEOUT_SECONDS=240

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=
OLLAMA_MODEL_OPTIONS=gemini-3-flash-preview:cloud,gemma4:31b-cloud,llama3.1,llama3.2

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 7 * * 1-5
SCHEDULER_TOPIC=agentic AI, MCP, SaaS infrastructure
# SCHEDULER_DOMAINS is only used as a fallback until the UI has synced a domain
# list to the server (domains.db). Once synced, the scheduler uses the same
# enabled-domain set the UI is configured with.
SCHEDULER_DOMAINS=arxiv.org,openai.com,langchain.com,github.blog,techcrunch.com
SCHEDULER_ANALYST_PROVIDER=ollama
SCHEDULER_WRITER_PROVIDER=ollama
SCHEDULER_ANALYST_MODEL=
SCHEDULER_WRITER_MODEL=
SCHEDULER_PERSONA=cto_phd
SCHEDULER_FORMAT=post

# Webhook trigger (POST /api/webhook/trigger, header X-Webhook-Secret)
# Unset WEBHOOK_SECRET disables the endpoint (returns 501). Runs go through the
# same review flow as scheduled runs (Scheduled Runs panel + email digest).
WEBHOOK_SECRET=
WEBHOOK_TOPIC=
WEBHOOK_ANALYST_PROVIDER=ollama
WEBHOOK_WRITER_PROVIDER=ollama
WEBHOOK_ANALYST_MODEL=
WEBHOOK_WRITER_MODEL=
WEBHOOK_FORMAT=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
BASE_URL=http://localhost:3010
